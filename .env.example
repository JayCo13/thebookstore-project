# ============================================================
# Environment Variables — EXAMPLE (Copy to .env and fill values)
# ============================================================
# NEVER commit the actual .env file to Git!

# === Frontend (set in Netlify Dashboard, NOT in .env) ===
REACT_APP_API_URL=https://tamnguon.com
REACT_APP_GHN_API_TOKEN=your_ghn_token
REACT_APP_GHN_SHOP_ID=your_shop_id
REACT_APP_GHN_API_BASE_URL=https://online-gateway.ghn.vn/shiip/public-api

# === Database ===
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=bookstore_db
MYSQL_USER=approot
MYSQL_PASSWORD=change_me

# === JWT ===
SECRET_KEY=generate_with_python_secrets_token_urlsafe_64
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET_KEY=generate_with_python_secrets_token_urlsafe_64
JWT_ALGORITHM=HS256

# === Email (Gmail App Password) ===
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=YourStore

# === Admin ===
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=use_a_strong_password

# === Google OAuth ===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://tamnguon.com/api/v1/auth/google/callback
FRONTEND_URL=https://your-site.netlify.app

# === Image Upload ===
UPLOAD_DIR=static/images
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# === App ===
APP_NAME=Bookstore API
DEBUG=False
ALLOWED_ORIGINS=https://your-site.netlify.app,https://tamnguon.com

# === GHN (Giao Hang Nhanh) ===
GHN_API_TOKEN=your_ghn_token
GHN_SHOP_ID=your_shop_id
GHN_BASE_URL=https://online-gateway.ghn.vn

# === Zalo OA ===
ZALO_BASE_URL=https://business.openapi.zalo.me
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_TEMPLATE_ID=your_template_id
ZALO_CALLBACK_URL=https://tamnguon.com/api/v1/auth/zalo/callback

# === AI (Groq) ===
GROQ_API_KEY=your_groq_key
GROQ_API_KEY_MOD=your_groq_mod_key
