# =============================================================================
# TEMPLATE ONLY — every value here must stay EMPTY.
#
# This file used to carry real credentials (a GHN token, Groq API keys, the mail
# app password, the admin password) and was committed publicly for as long as it
# existed. GitHub push protection now blocks any push that re-adds them.
#
# Removing them here does NOT un-leak them: they are still in this repo's git
# history. Anything that was ever in this file must be rotated.
# =============================================================================


Glob
# Frontend env
ALLOWED_ORIGINS=https://tamnguon.com,https://www.tamnguon.com
# Shipping needs NO frontend variable at all. GoShip requires a Bearer token on
# every endpoint — including the address book — and that token can also book
# shipments, so it never reaches the browser. Both the location lookups and the
# quotes go through the goship-locations / goship-shipping-fee edge functions.
REACT_APP_GROG_API_KEY=
REACT_APP_GROG_API_URL=https://api.groq.com/openai/v1
ZALO_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=
REACT_APP_API_URL=https://api.tamnguon.com
REACT_APP_API_URL=https://api.tamnguon.com
FRONTEND_URL=https://tamnguon.com

# Backend env
# Database Configuration
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=bookstore_db
MYSQL_USER=approot
MYSQL_PASSWORD=

# JWT Configuration
SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="30"

# Email Configuration
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT="587"
MAIL_SERVER="smtp.gmail.com"
MAIL_FROM_NAME="TheBookstore"

# Admin Configuration
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://api.tamnguon.com/api/v1/auth/google/callback"

# Image Configuration
UPLOAD_DIR=static/images
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp

# App Configuration
APP_NAME=Bookstore API
DEBUG=True
ALLOWED_ORIGINS=https://tamnguon.com,

# GoShip (shipping aggregator) — set these as Supabase function secrets:
#   supabase secrets set GOSHIP_USERNAME=... GOSHIP_PASSWORD=... ...
# Credentials are generated in the GoShip portal (Kết nối API → Generate):
#   sandbox    https://dev-shop.goship.io/developers  -> https://sandbox.goship.io/api/v2
#   production https://shop.goship.io/developers      -> https://api.goship.io/api/v2
# The edge functions log in once and cache the token in public.integration_tokens.
# NOTE: the token lasts 15 days, not the ~10 years the docs claim — measured.
GOSHIP_BASE_URL=https://api.goship.io/api/v2
GOSHIP_USERNAME=
GOSHIP_PASSWORD=
GOSHIP_CLIENT_ID=
GOSHIP_CLIENT_SECRET=

# Pickup address, in GoShip's own codes (tra qua /cities, /districts, /wards).
# Values below are the shop's current origin, resolved against GoShip's data:
#   city 700000 = Hồ Chí Minh, district 701200 = Quận 12, ward 9075 = Tân Thới Hiệp
# Quote any value containing spaces, or a shell sourcing this file truncates it.
GOSHIP_SENDER_NAME="Tâm Nguồn Book"
GOSHIP_SENDER_PHONE=
GOSHIP_SENDER_STREET="35/6 đường TTH15 Tổ 30 KP3A"
GOSHIP_SENDER_CITY=700000
GOSHIP_SENDER_DISTRICT=701200
GOSHIP_SENDER_WARD=9075

# Carriers the shop will ship with, as GoShip short names. Empty = whichever
# GoShip offers. Narrowing this is how a carrier is dropped without a code
# change — the reason for using an aggregator at all.
#   seen in production: shopee, vnp, best, ghnv3, jnt, jnt2, vtp, njv, ems, ...
# If none of the listed carriers serves a route, the quote falls back to the
# full list and logs a warning, rather than leaving the customer unable to order.
GOSHIP_CARRIERS=shopee,vnp,jnt

# The status webhook is signed by GoShip with HMAC-SHA256 over the raw body,
# keyed on GOSHIP_CLIENT_SECRET above — there is no separate webhook secret to
# set. Register the endpoint in the portal under "Goship API Webhooks".

ZALO_BASE_URL=https://business.openapi.zalo.me
#ZALO CONFIG
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_TEMPLATE_ID=
ZALO_CALLBACK_URL=https://api.tamnguon.com/api/v1/auth/zalo/callback

GROQ_API_KEY=
GROQ_API_KEY_MOD=

# PayOS Payment Gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=https://tamnguon.com/checkout/success
PAYOS_CANCEL_URL=https://tamnguon.com/checkout

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256